    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "jose": "^4.14.4",
    "next": "^16.3.4",
    "nice-grpc": "^2.1.17",
    "protobufjs": "^8.8.0",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "grpc-tools": "^1.13.1",
    "ts-proto": "^2.12.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "grpc-tools@1.13.1": true,
    "unrs-resolver@1.12.2": true,
    "@bufbuild/buf@1.72.0": true
  }
